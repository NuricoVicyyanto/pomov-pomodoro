{
  "expo": {
    "name": "Pomov",
    "slug": "pomov",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000"
    },
    "androidNavigationBar": {
      "visible": "immersive"
    },
    "android": {
      "package": "id.fokusoffline.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#B5765A",
          "defaultChannel": "pomodoro-timer"
        }
      ],
      "expo-sqlite",
      "expo-audio",
      "expo-font",
      "expo-asset"
    ]
  }
}
